# ---------------------------------------------------------------------------
# Faruq Management - environment configuration
#
# Copy to `.env` in the same folder and fill in. NEVER commit the real .env.
# ---------------------------------------------------------------------------

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Set DATABASE_URL for hosted Postgres (Neon, Supabase, Railway). When it is
# present it wins and the DB_* values below are ignored.
# DATABASE_URL=postgresql://user:pass@host/dbname
DB_NAME=faruq_db
DB_USER=faruq_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# ---------------------------------------------------------------------------
# Staff registration passcodes
# ---------------------------------------------------------------------------
# These replace `python manage.py createsuperuser`. A new staff member opens
# /accounts/register/, picks a role, and types the passcode for that role.
#
# READ THIS BEFORE SETTING THEM:
#
#   * PASSCODE_ADMIN creates ADMINISTRATOR accounts. An administrator can see
#     every manager's products, customers, sales and profit figures. Treat
#     this string exactly like the keys to the shop.
#
#   * A passcode is SHARED. It cannot be revoked for one person - changing it
#     affects everyone who has not registered yet.
#
#   * Leaving one BLANK disables registration for that role entirely, and the
#     role stops appearing on the form. Leaving BOTH blank turns the whole
#     registration page off. That is the safe default, not a bug.
#
#   * Wrong attempts are rate limited to 5 per IP per 15 minutes and every
#     attempt is written to the audit log with its IP address.
#
# Use long, unguessable values - not "admin123".
PASSCODE_ADMIN=
PASSCODE_MANAGER=

# Master switch. Set False to close registration without clearing the codes.
REGISTRATION_ENABLED=True

# ---------------------------------------------------------------------------
# Cloudinary media storage
# ---------------------------------------------------------------------------
# Receipts, payment proofs and profile photos are stored here instead of on
# local disk.
#
# WHY THIS MATTERS: hosts like Render, Railway and Fly give you an EPHEMERAL
# filesystem. Anything written to backend/media/ is deleted on the next deploy
# or restart. A receipt is the evidence behind a payment, so losing it quietly
# is not survivable for a credit business.
#
# Behaviour is driven by whether all three values are filled in:
#   all three set  -> uploads go to Cloudinary
#   any one blank  -> uploads go to local backend/media/ (fine for development)
#
# Get these from the Cloudinary dashboard, "Product Environment Credentials".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
MAX_RECEIPT_SIZE_MB=5

# ---------------------------------------------------------------------------
# Business details - shown on receipts and in the app header
# ---------------------------------------------------------------------------
BUSINESS_NAME=Faruq Trading
BUSINESS_PHONE=
BUSINESS_ADDRESS=
CURRENCY_SYMBOL=ETB
DEFAULT_CREDIT_DUE_DAYS=30
TIME_ZONE=Africa/Addis_Ababa

# Credit sales at or above this amount notify administrators. 0 disables it.
LARGE_CREDIT_ALERT=0

# ---------------------------------------------------------------------------
# Push notifications (optional)
# ---------------------------------------------------------------------------
FCM_ENABLED=False
FIREBASE_CREDENTIALS=firebase-service-account.json

# ---------------------------------------------------------------------------
# CORS - tighten in production
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=
